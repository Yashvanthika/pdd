# Runtime variables for the Dokploy application Environment tab.
NODE_ENV=production
PORT=3000

# Public API domain assigned in Dokploy Domains.
APP_URL=https://bloodlink.example.com

# Allow the iOS app shell to call this backend when VITE_API_BASE_URL points here.
# Add your production web domain too if the frontend is hosted elsewhere.
CORS_ORIGINS=capacitor://localhost,http://localhost

# Server-side AI outreach key. Keep this private in Dokploy.
GEMINI_API_KEY=

# Supabase auth verification for backend endpoints.
SUPABASE_URL=https://ivytidzhluxpmxurpyra.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Build-time arguments for Vite. Add these in Dokploy's Dockerfile build args.
VITE_SUPABASE_URL=https://ivytidzhluxpmxurpyra.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=https://bloodlink.example.com
