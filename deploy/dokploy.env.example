# Runtime variables for the Dokploy application Environment tab.
NODE_ENV=production
PORT=3000

# Public API domain assigned in Dokploy Domains.
APP_URL=https://bloodlink.example.com

# Allowed origins for browser-based clients or hosted tools that call the API.
CORS_ORIGINS=https://bloodlink.example.com

# Supabase Auth and donor profile storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In Dokploy, use /api/live for the container health check and /api/health for database readiness checks.
