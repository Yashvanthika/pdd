# Server-side AI outreach service key.
GEMINI_API_KEY=""

# Supabase client configuration.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side Supabase auth verification. For local development these can match
# the VITE_ values above; in Dokploy use service Environment variables.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Optional browser/mobile API origin.
# Leave blank for same-origin web hosting. Set for Capacitor/iOS builds when
# the backend is hosted separately from the app shell.
VITE_API_BASE_URL=""

# Public app URL, used only by deployments that need self-referential links.
APP_URL=""

# Optional comma-separated browser origins allowed to call the backend.
# For iOS builds, include capacitor://localhost when VITE_API_BASE_URL is remote.
CORS_ORIGINS=""
