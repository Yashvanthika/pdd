{
  "name": "bloodlink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "dev:server": "tsx server.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "pnpm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "latest",
    "@react-native-firebase/app": "latest",
    "@react-native-firebase/auth": "latest",
    "@react-navigation/native": "latest",
    "@react-navigation/native-stack": "latest",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "esbuild": "^0.25.0",
    "expo": "latest",
    "expo-secure-store": "latest",
    "expo-status-bar": "latest",
    "react": "latest",
    "react-native": "latest",
    "react-native-gesture-handler": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-screens": "latest",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
